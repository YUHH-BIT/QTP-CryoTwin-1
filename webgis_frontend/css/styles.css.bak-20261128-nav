  color: #7dd3fc;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(59, 130, 246, 0.05));
  border: 1px solid rgba(59, 130, 246, 0.3);
}
.decision-content-card-meta {
  flex: 1;
  min-width: 0;
}
.decision-content-card-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-primary);
