  .topbar .logo { white-space: nowrap; overflow: hidden; max-width: 34vw; }
  .topbar .logo-name { overflow: hidden; text-overflow: ellipsis; }
  .topbar .logo-code { display: none; } /* 到这一步才真正放不下代号 */
  .topbar .logo::after { display: none; }
  /* 不能给 nav-links 设 overflow（会造成滚动容器），否则绝对定位的下拉菜单会被裁掉 */
  .topbar .nav-links { overflow: visible; }
  .topbar .nav-links a:not(.dropdown-item) { font-size: 12px; padding: 0 5px; }
  .topbar input[type="search"] { width: 120px; }
}

/* ============ 切页与状态的平滑过渡 ============
   1) 多页应用每次跳转都是硬闪：用跨文档 View Transitions（Chrome / Edge 126+）让内容区淡入淡出；
   2) 顶栏 7 个页面结构完全一致，单独命名并禁用动画，切页时视觉上保持连续，观感接近单页应用；
   3) 不支持的浏览器会自动忽略这些规则，属渐进增强，无副作用。 */
@view-transition {
  navigation: auto;
}

.topbar {
  view-transition-name: app-topbar;
}

::view-transition-old(root) {
  animation: vt-fade-out 0.14s ease both;
}
::view-transition-new(root) {
  animation: vt-fade-in 0.24s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}
/* 顶栏不参与淡化与位移 */
::view-transition-group(app-topbar),
::view-transition-old(app-topbar),
::view-transition-new(app-topbar) {
  animation: none;
}

@keyframes vt-fade-out {
  to { opacity: 0; }
}
@keyframes vt-fade-in {
  from { opacity: 0; }
}

/* 系统设置了「减少动效」时全部退化为瞬切 */
@media (prefers-reduced-motion: reduce) {
  .topbar .nav-links a:not(.dropdown-item),
  .topbar .nav-links a:not(.dropdown-item)::before,
  .dropdown-menu,
  .dropdown-toggle::after,
  .dropdown-item {
    transition-duration: 0.01ms !important;
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }
}

/* ============ 顶栏右侧：搜索框 + 身份区（2026-11-28） ============
   原「系统管理」一级导航项已撤销，改由右上角身份区承载：
