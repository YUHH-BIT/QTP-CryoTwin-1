}
.decision-detail-block {
  padding: 8px 0;
  font-size: 12px;
  line-height: 1.7;
  color: var(--text-primary);
  border-bottom: 1px dashed rgba(58, 74, 102, 0.4);
}
.decision-detail-block:last-child {
