}
.expert-search input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  color: var(--text-primary);
  font-size: 13px;
}
.expert-search input::placeholder {
  color: #7c8aa5;
}
.decision-content-sidebar .expert-search { margin: 10px 0 6px; }

/* 领域筛选 chips */
.expert-field-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.expert-chip {
  padding: 4px 12px;
  font-size: 12px;
  color: var(--text-secondary);
