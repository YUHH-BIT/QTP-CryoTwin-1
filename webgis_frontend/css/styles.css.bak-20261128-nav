/* ============ 单行导航栏自适应 ============
   系统名 + 模块按钮 + 搜索框挤在同一行，按 1560 / 1360 / 1300 / 1180 / 1100 / 900 逐级压缩，
   保证模块条居中时不顶到品牌区、搜索框不被压到无法输入。 */
@media (max-width: 1560px) {
  .topbar .logo { margin-right: 14px; }
  .topbar .logo-name { font-size: 15.5px; }
  .topbar .logo-code { font-size: 10px; }
  .topbar .logo-img { width: 28px; height: 28px; }
  .topbar .nav-links a:not(.dropdown-item) { padding: 0 10px; }
}

@media (max-width: 1400px) {
  .topbar { padding: 0 14px; }
  .topbar .logo { margin-right: 10px; }
  .topbar .logo-name { font-size: 14px; letter-spacing: 0.3px; }
  .topbar .logo-code { font-size: 9px; padding-left: 8px; margin-left: 8px; }
  .topbar .logo-img { width: 26px; height: 26px; margin-right: 8px; }
  .topbar .logo::before { height: 16px; margin-right: 9px; }
  .topbar .nav-links { padding: 3px; border-radius: 9px; }
  .topbar .nav-links a:not(.dropdown-item) { font-size: 12.5px; padding: 0 7px; height: 30px; border-radius: 6px; }
  .topbar .dropdown-toggle::after { margin-left: 4px; font-size: 9px; }
  .topbar .searchbar.cmd-mode input[type="search"] { width: 140px; font-size: 13px; }
}

@media (max-width: 1300px) {
  /* 1200 上下是临界区：品牌 + 代号 + 六个模块 + 搜索框刚好占满，再挤就贴上了 */
  .topbar .logo-name { font-size: 14px; }
  .topbar .logo-code { font-size: 9px; letter-spacing: 0.3px; padding-left: 7px; margin-left: 7px; }
  .topbar .nav-links a:not(.dropdown-item) { font-size: 12.5px; padding: 0 6px; }
  .topbar .searchbar.cmd-mode input[type="search"] { width: 120px; }
}

@media (max-width: 1180px) {
  .topbar .logo-name { font-size: 13.5px; letter-spacing: 0; }
  .topbar .logo-code { font-size: 8.5px; letter-spacing: 0.3px; }
  .topbar .nav-links a:not(.dropdown-item) { font-size: 12.5px; padding: 0 6px; }
  .topbar .searchbar.cmd-mode input[type="search"] { width: 110px; }
}

/* 窄屏放弃「模块条居中」——空间不够时会顶到系统名，回退成靠左排布 */
