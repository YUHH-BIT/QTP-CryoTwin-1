}
.decision-content-card-head {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px;
  cursor: pointer;
  transition: background 0.2s ease;
}
.decision-content-card-head:hover {
  background: rgba(59, 130, 246, 0.08);
}
.decision-content-card-icon {
