/* 确保图例在不同缩放级别下保持清晰 */
@media (max-width: 768px) {
  .legend-container {
    padding: 12px;
  }
  
  .legend-text {
    font-size: 13px;
  }
  
  .legend-symbol {
    width: 35px;
  }
  
  .legend-symbol.point-symbol {
    margin-right: 23px;
  }
}

.topbar .user:hover {
  background: var(--card-hover);
}

/* 品牌区：纯色标题 + 冰晶竖条，右侧一道细分隔线，去掉渐变文字与发光（与搜索框的克制感统一） */
.topbar .logo {
  display: flex;
  align-items: center;
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 0.6px;
  color: #eef4fc;
  margin-right: 24px;
  /* 不要给 .logo 加 text-shadow：渐变字的填充是透明的，阴影会浮在字形外圈变成脏影 */
  filter: none;
  position: relative;
}

/* 系统图标（img/logo-icon.png，128×128 RGBA）：30px 圆角方，自带深蓝底，只补一点外发光 */
.topbar .logo-img {
  width: 30px;
  height: 30px;
  margin-right: 10px;
  border-radius: 8px;
  flex: none;
  object-fit: contain;
  filter: drop-shadow(0 2px 8px rgba(37, 99, 235, 0.35));
}

/* 有了图标就不再需要前置冰晶竖条 */
.topbar .logo::before {
  display: none;
}

/* 品牌与模块之间的分隔改用「系统代号左侧的竖线」，这里不再重复画一条 */
.topbar .logo::after {
  display: none;
}

/* 系统名：整串走「白 → 淡冰蓝」的左到右渐变（横跨 240px，渐变才看得出来；
   纵向渐变在 17px 字高上跨度太小，等于没渐变）。末端用亮蓝而不是灰蓝，避免后半句发灰。
   「冰冻圈」三字用同一色系但更亮一档，保持关键词层次又不打断整串的连续性。
   注意 text-shadow 在 background-clip:text + 透明填充下会浮在字形外圈变成脏影，必须去掉。 */
.topbar .logo-name {
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 0.6px;
  color: #eef4fc; /* 不支持 background-clip:text 时的回退色 */
  background: linear-gradient(96deg, #ffffff 0%, #d8efff 30%, #7fcdfb 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  white-space: nowrap;
}

/* 「冰冻圈」跟随整串渐变，不再自己起一段——单独设渐变会在渐变中段插一段白，
   反而让这三个字比周围更亮、跳出来一块。 */
.topbar .logo-key {
  font-style: normal;
}

/* 系统代号：Chakra Petch 是科技感拉丁字体，中文用不上、这里正好用得上 */
.topbar .logo-code {
  font-family: var(--font-display);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.8px;
  color: #6b83a3;
  padding-left: 10px;
  margin-left: 10px;
  border-left: 1px solid rgba(148, 163, 184, 0.22);
  white-space: nowrap;
  flex: none;
}

.topbar .logo img {
  height: 32px;
  margin-right: 8px;
  filter: drop-shadow(0 0 4px var(--primary-glow));
}

.topbar .searchbar {
  flex: 0 0 auto;
  margin-left: auto;
  display: flex;
  align-items: center;
}

.topbar input[type="search"] {
  width: 340px;
  height: 34px;
  border: 1px solid var(--border-color);
  border-radius: 17px;
  padding: 0 16px;
  font-size: 15px;
  outline: none;
  background: var(--card-bg);
  color: var(--text-primary);
  transition: all 0.2s;
}

.topbar input[type="search"]:focus {
  border-color: var(--primary);
  background: var(--sidebar-bg);
  box-shadow: 0 0 0 2px var(--primary-glow);
}

/* 已统一到上方的导航栏样式中 */

#map {
  width: 100vw;
  height: var(--map-height);
  position: absolute;
  top: var(--nav-height);
  left: 0;
  z-index: 1;
  background: #0f172a;
}

/* 控制面板 */
.sidepanel {
    box-sizing: border-box;
position: absolute;
  top: calc(var(--nav-height) + 16px);
  left: 16px; /* 悬浮岛：四周留白，不贴边 */
  width: 320px;
  max-height: calc(100vh - var(--nav-height) - 32px);
  background: rgba(18, 30, 50, 0.9);
  border: 1px solid rgba(125, 211, 252, 0.12);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35), 0 2px 8px rgba(0, 0, 0, 0.2);
  z-index: 25;
  padding: 14px 16px 16px;
  transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease;
  backdrop-filter: blur(14px);
  border-radius: 16px; /* 大圆角悬浮卡片 */
  overflow-y: auto;
}

/* 收起状态：移出左侧视口（由展开按钮唤起） */
.sidepanel.collapsed {
  left: -340px;
  opacity: 0;
  pointer-events: none;
}

/* 悬浮岛头部：标题「图层管理」+ 收起按钮 */
.sidepanel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
  padding-bottom: 8px;
  border-bottom: 1px solid rgba(58, 74, 102, 0.45);
}
.sidepanel-head-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 7px;
}
.sidepanel-head-title i {
  color: #7dd3fc;
  font-size: 13px;
}
.sidepanel-collapse-btn {
  background: none;
  border: none;
  color: var(--text-secondary);
  font-size: 16px;
  cursor: pointer;
  width: 26px;
  height: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  transition: all 0.2s ease;
}
.sidepanel-collapse-btn:hover {
  background: rgba(59, 130, 246, 0.15);
  color: var(--text-primary);
}

/* 展开按钮：面板收起时显示在左侧边缘的小圆钮 */
.sidepanel-toggle {
  position: absolute;
  top: calc(var(--nav-height) + 16px);
  left: 16px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1px solid rgba(125, 211, 252, 0.25);
  background: rgba(18, 30, 50, 0.92);
  color: #7dd3fc;
  font-size: 16px;
  cursor: pointer;
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 24;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  transition: all 0.2s ease;
}
.sidepanel-toggle:hover {
  border-color: var(--primary);
  color: #fff;
  transform: translateY(-1px);
}
body.sidepanel-collapsed .sidepanel-toggle {
  display: flex;
}

/* 右侧灾害侧边栏 */
.disaster-sidebar {
  scrollbar-width: none;
    box-sizing: border-box;
position: absolute;
  height: calc(100vh - var(--nav-height) - 32px);
  top: calc(var(--nav-height) + 16px);
  right: -420px; /* 默认完全隐藏，由导航显式打开 */
  width: 400px;
  background: var(--sidebar-bg);
  border: 1px solid var(--sidebar-border);
  box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
  z-index: 30;
  padding: 20px;
  transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  backdrop-filter: blur(12px);
  background: rgba(30, 41, 59, 0.98);
  overflow-y: auto;
  border-radius: 16px;
}

.disaster-sidebar.active {
  right: 16px;
}

/* 右侧模拟侧边栏 */
.simulate-sidebar {
  scrollbar-width: none;
    box-sizing: border-box;
position: absolute;
  height: calc(100vh - var(--nav-height) - 32px);
  top: calc(var(--nav-height) + 16px);
  right: -420px; /* 默认完全隐藏，由导航显式打开 */
  width: 400px;
  background: var(--sidebar-bg);
  border: 1px solid var(--sidebar-border);
  box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
  z-index: 30;
  padding: 20px;
  transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  backdrop-filter: blur(12px);
  background: rgba(30, 41, 59, 0.98);
  overflow-y: auto;
  border-radius: 16px;
}

.simulate-sidebar.active {
  right: 16px;
}

/* 右侧风险评估侧边栏 */
.alert-sidebar {
  scrollbar-width: none;
    box-sizing: border-box;
position: absolute;
  height: calc(100vh - var(--nav-height) - 32px);
  top: calc(var(--nav-height) + 16px);
  right: -420px; /* 默认完全隐藏，由导航显式打开 */
  width: 400px;
  background: var(--sidebar-bg);
  border: 1px solid var(--sidebar-border);
  box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
  z-index: 30;
  padding: 20px;
  transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  backdrop-filter: blur(12px);
  background: rgba(30, 41, 59, 0.98);
  overflow-y: auto;
  border-radius: 16px;
}

.alert-sidebar.active {
  right: 16px;
}

/* 侧边栏遮罩：打开时覆盖地图区，点击关闭（与 decision-sidebar-mask 同一套行为） */
  .disaster-sidebar-mask,
.simulate-sidebar-mask,
.alert-sidebar-mask {
  position: fixed;
  top: var(--nav-height);
  left: 0;
  right: 0;
  bottom: 0;
  background: transparent; /* 非模态：不遮挡地图视线 */
