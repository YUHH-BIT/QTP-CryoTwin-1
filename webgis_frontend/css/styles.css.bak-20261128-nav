}

/* 内容卡片 */
.decision-content-card {
  background: var(--sidebar-bg);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  overflow: hidden;
  transition: border-color 0.2s ease;
}
.decision-content-card.expanded {
