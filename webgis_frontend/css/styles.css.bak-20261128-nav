  flex-shrink: 0;
}

/* 分类筛选 chips */
.decision-content-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.decision-chip {
  padding: 4px 12px;
  font-size: 12px;
  color: var(--text-secondary);
  background: var(--sidebar-bg);
  border: 1px solid var(--border-color);
  border-radius: 14px;
