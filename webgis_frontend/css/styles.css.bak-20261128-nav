  color: #7dd3fc;
}

/* ============================================================
   通用单选下拉增强组件（Enhanced Select）
   ============================================================ */
.es-select {
  position: relative;
  width: 100%;
  margin-bottom: 8px;
}
.es-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
  padding: 8px 12px;
  font-size: 13px;
  color: var(--text-primary);
  background: var(--sidebar-bg);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  cursor: pointer;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
  box-sizing: border-box;
  text-align: left;
}
.es-trigger:hover {
  border-color: var(--primary);
}
.es-select.open .es-trigger {
  border-color: var(--primary);
  box-shadow: 0 0 0 1px var(--primary);
}
.es-value {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--text-secondary);
}
.es-select.es-has-value .es-value {
  color: var(--text-primary);
}
.es-arrow {
  color: var(--text-secondary);
  font-size: 12px;
  transition: transform 0.2s ease;
  flex-shrink: 0;
}
.es-select.open .es-arrow {
  transform: rotate(180deg);
  color: var(--primary);
}

/* 下拉菜单 */
.es-menu {
  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  right: 0;
  max-height: 220px;
  overflow-y: auto;
  margin: 0;
  padding: 4px;
  list-style: none;
  background: rgba(16, 26, 44, 0.98);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  z-index: 50;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-4px);
  transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
  scrollbar-width: thin;
  scrollbar-color: var(--primary-dark) transparent;
}
.es-select.open .es-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}
.es-option {
  padding: 7px 10px;
  font-size: 13px;
  color: var(--text-primary);
  border-radius: 6px;
  cursor: pointer;
  transition: background 0.15s ease;
}
.es-option:hover,
.es-option.hover {
  background: rgba(59, 130, 246, 0.18);
  color: #fff;
}
.es-option.selected {
  color: #7dd3fc;
  font-weight: 600;
}
.es-option.selected::after {
  content: '\f00c';
  font-family: 'FontAwesome';
  float: right;
  font-size: 11px;
  color: var(--primary);
}
.es-option.disabled {
  color: #5a6a85;
  cursor: not-allowed;
  background: none;
}
.es-group-label {
  padding: 6px 10px 2px;
  font-size: 11px;
  font-weight: 700;
  color: #7dd3fc;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.disaster-sidebar::-webkit-scrollbar,
.simulate-sidebar::-webkit-scrollbar,
.alert-sidebar::-webkit-scrollbar,
.decision-sidebar::-webkit-scrollbar {
  display: none;
}

.mega-col {
  flex: 1;
  min-width: 0;
}
.mega-col + .mega-col {
  border-left: 1px solid var(--border-color);
  padding-left: 14px;
}
.mega-col-title {
  font-size: 12px;
  font-weight: 700;
  color: #7dd3fc;
  margin-bottom: 8px;
  padding-bottom: 6px;
  border-bottom: 1px dashed rgba(58, 74, 102, 0.5);
  display: flex;
  align-items: center;
  gap: 6px;
  letter-spacing: 0.5px;
}
.mega-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 9px 10px;
  border-radius: 8px;
  color: var(--text-primary);
  text-decoration: none;
  transition: background 0.2s ease;
  margin-bottom: 2px;
}
.mega-item:hover {
  background: rgba(59, 130, 246, 0.14);
}
.mega-item.active {
  background: rgba(59, 130, 246, 0.18);
  color: #fff;
}
.mega-item-icon {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: #7dd3fc;
  background: rgba(59, 130, 246, 0.12);
  border: 1px solid rgba(59, 130, 246, 0.2);
}
.mega-item-text {
  min-width: 0;
}
.mega-item-name {
  display: block;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
}
.mega-item-desc {
  display: block;
  font-size: 11px;
  color: var(--text-secondary);
  margin-top: 2px;
  white-space: nowrap;
}

/* ============ 气象水文查询子面板（meteo-query.js） ============ */
.meteo-subpanel {
  padding: 6px 0 6px 24px;
  border-left: 2px solid var(--ice-glow);
  margin: 4px 0 6px 0;
}
.meteo-subpanel[hidden] { display: none; }
.meteo-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 6px 0;
  flex-wrap: wrap;
}
.meteo-row label {
  color: var(--text-secondary);
  font-size: 12px;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.meteo-row input[type="date"] {
  padding: 4px 6px;
  background: var(--card-bg);
  color: var(--text-primary);
  border: 1px solid var(--border-color);
  border-radius: 4px;
  font-size: 12px;
  width: 132px;
  box-sizing: border-box;
}
.meteo-radio { cursor: pointer; }
.meteo-radio input { accent-color: var(--primary); margin: 0; }
.meteo-hint {
  color: var(--text-secondary);
  font-size: 11px;
  margin-left: auto;
}
.meteo-btn {
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 6px 14px;
  font-size: 13px;
  cursor: pointer;
  transition: background .2s;
}
.meteo-btn:hover:not(:disabled) { background: var(--primary-dark); }
.meteo-btn:disabled { background: var(--card-hover); color: var(--text-secondary); cursor: default; }
.meteo-result-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 6px;
  font-size: 12px;
}
.meteo-result-table th,
.meteo-result-table td {
  padding: 5px 6px;
  border-bottom: 1px solid var(--border-color);
  text-align: left;
}
.meteo-result-table th {
  color: var(--ice-bright);
  font-weight: 600;
  white-space: nowrap;
}
.meteo-result-table td { color: var(--text-primary); }
.meteo-load-btn {
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 4px;
  padding: 3px 8px;
  font-size: 11px;
  cursor: pointer;
  transition: background .2s;
}
.meteo-load-btn:hover:not(:disabled) { background: var(--primary-dark); }
.meteo-load-btn:disabled {
  background: var(--card-hover);
  color: var(--text-secondary);
  cursor: default;
}


/* ==================== 三维示范区（Cesium） ==================== */
/* Cesium 容器：挂在 #map 内的绝对定位覆盖层，z-index 继承 #map(1)，
   天然位于左侧图层面板(25)与右侧决策侧栏(30)之下。
   注意：不隐藏 .cesium-viewer-bottom（Cesium/数据署名条，需保留）。 */
.cesium-container {
  position: absolute;
  inset: 0;
  display: none;
  background: #0f172a;
}

.scene3d-controls {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 12px;
}

.scene3d-control-row {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.scene3d-control-row > label {
  font-size: 12px;
  color: var(--text-secondary);
}

.scene3d-control-row select {
  background: var(--input-bg, rgba(15, 23, 42, 0.6));
  color: var(--text-primary);
  border: 1px solid var(--sidebar-border);
  border-radius: 8px;
  padding: 7px 10px;
  font-size: 13px;
}

.scene3d-control-row .mode-switch button {
  flex: 1;
  padding: 6px 10px;
  font-size: 12px;
}

.scene3d-camera-btns {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.scene3d-camera-btns button {
  flex: 1;
  min-width: 80px;
  padding: 6px 8px;
  font-size: 12px;
  border: 1px solid var(--sidebar-border);
  border-radius: 8px;
  background: rgba(56, 189, 248, 0.12);
  color: var(--text-primary);
  cursor: pointer;
  transition: background 0.2s ease;
}

.scene3d-camera-btns button:hover {
  background: rgba(56, 189, 248, 0.28);
}

.scene3d-layer-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 13px;
}

.scene3d-layer-item {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
}

.scene3d-layer-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
}

.scene3d-control-row input[type="range"] {
  width: 100%;
  accent-color: var(--primary);
}

.scene3d-status {
  margin-top: 12px;
  padding: 8px 10px;
  font-size: 12px;
  line-height: 1.6;
  color: var(--text-secondary);
  background: rgba(15, 23, 42, 0.45);
  border: 1px solid var(--sidebar-border);
  border-radius: 8px;
  min-height: 20px;
}

.scene3d-status.error {
  color: #fca5a5;
  border-color: rgba(248, 113, 113, 0.45);
}

/* 说明条里的文字整体作为单一 flex 子项：否则 <strong> 会把文本拆成多个
   flex 子项，各自被压到 1-2 个字宽，渲染成竖排窄条 */
.decision-content-note > span {
  flex: 1;
  min-width: 0;
}

/* 三维视图自绘署名条（替代 Cesium 默认 creditContainer，后者含 ion 云服务默认署名） */
.scene3d-credit {
  position: absolute;
  left: 10px;
  bottom: 8px;
  z-index: 2;
  font-size: 11px;
  line-height: 1.4;
  color: rgba(226, 232, 240, 0.78);
  background: rgba(10, 17, 31, 0.6);
  border: 1px solid rgba(125, 211, 252, 0.18);
  border-radius: 6px;
  padding: 3px 8px;
  pointer-events: none;
  max-width: 60%;
}

/* 三维场景状态覆盖层：初始化中 / 失败时必须显眼，
   否则 Cesium 没起来时用户看到的是底下那张二维地图，只会觉得"这根本不是三维" */
.scene3d-overlay {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 24px;
  text-align: center;
  font-size: 15px;
  line-height: 1.9;
  color: #dbeafe;
  background: rgba(8, 14, 26, 0.88);
}

.scene3d-overlay.error {
  color: #fecaca;
}

.scene3d-overlay .sub {
  font-size: 12px;
  color: rgba(203, 213, 225, 0.85);
}

.scene3d-overlay.error .sub {
  color: rgba(252, 202, 202, 0.85);
}

/* ==========================================================================
   右侧栏统一口径（2026-11-27）
   参照 terrain3d/demo：半透明深蓝卡片 + 边缘竖标签折叠 + 10px 圆角。
   仅对四个业务页（body.rhs-v2）生效；导航 / 地图 / 其他页面不受影响。
   原有 DOM id、.active / .collapsed 语义与全部业务事件保持不变。
   ========================================================================== */
body.rhs-v2 {
  --rhs-w: 268px;          /* 左侧 .sidepanel 宽度（2026-11-27 20:49 由 320 收窄） */
  --rhs-panel-w: 320px;    /* 右侧抽屉实际宽度，由 rhs-tabs.js 按内容测量后覆盖 */
  --rhs-gap: 12px;
  --rhs-surface: rgba(19, 31, 51, .92);
  --rhs-card: rgba(27, 40, 64, .58);
  --rhs-line: #22344e;
  --rhs-line-2: #2f4564;
  --rhs-ink: #e6edf7;
  --rhs-ink-2: #b7c6dc;
  --rhs-ink-3: #8496b0;
  --rhs-ice: #7dd3fc;
}

/* ---------- 模块主题色变量（2026-11-27 18:04）----------
   --mod     模块主色：勾选标记 / 焦点环 / 表头底 / 按钮底
   --mod-ink 提亮版：标题 / 竖标签 / 收起按钮 / 字段标签（小字要亮，才看得清）
   --mod-soft 半透明底：选中行 / 表头
   --mod-line 半透明线：选中行边框 / 标题下划线
   首页与系统管理不加载 rhs-v2，继续用系统主色。 */
body.rhs-v2[data-module="disaster"] {
  --mod: #fbbf24; --mod-ink: #fef3c7; --mod-deep: #d97706;
  --mod-soft: rgba(251, 191, 36, .12); --mod-line: rgba(251, 191, 36, .45);
}
body.rhs-v2[data-module="simulate"] {
  --mod: #4ade80; --mod-ink: #d1fae5; --mod-deep: #16a34a;
  --mod-soft: rgba(74, 222, 128, .12); --mod-line: rgba(74, 222, 128, .45);
}
body.rhs-v2[data-module="alert"] {
  --mod: #fb7185; --mod-ink: #fecdd3; --mod-deep: #e11d48;
  --mod-soft: rgba(251, 113, 133, .12); --mod-line: rgba(251, 113, 133, .45);
}
body.rhs-v2[data-module="decision"] {
  --mod: #c084fc; --mod-ink: #e9d5ff; --mod-deep: #9333ea;
  --mod-soft: rgba(192, 132, 252, .12); --mod-line: rgba(192, 132, 252, .45);
}

/* ---------- 滑出式分类抽屉：尺寸 / 表面 / 开合 ---------- */
body.rhs-v2 .disaster-sidebar,
body.rhs-v2 .simulate-sidebar,
body.rhs-v2 .alert-sidebar,
body.rhs-v2 .decision-sidebar {
  position: absolute;
  top: calc(var(--nav-height) + var(--rhs-gap));
  right: calc(0px - var(--rhs-panel-w) - 24px);
  /* 宽高都按内容自适应，各设上下限；超出上限时内部滚动 */
  width: fit-content;
  min-width: 280px;
  max-width: min(420px, 44vw);
  height: auto;
  min-height: 120px;
  max-height: calc(100vh - var(--nav-height) - 22px);
  box-sizing: border-box;
  padding: 12px;
  background: var(--rhs-surface);
  border: 1px solid var(--rhs-line-2);
  border-radius: 10px;
  box-shadow: 0 8px 30px rgba(0, 0, 0, .38);
  backdrop-filter: blur(10px);
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: thin;
  scrollbar-color: rgba(125, 211, 252, .32) transparent;
  transition: right .24s ease, opacity .2s ease;
}
body.rhs-v2 .decision-sidebar { display: flex; flex-direction: column; }
/* 灾害数据库：图层名带灾害类型与计数，fit-content 会把面板撑到 420px。
   收窄到 300px，靠高度换宽度（图层名允许折两行，见下方 .disaster-layer-name）。 */
body.rhs-v2 .disaster-sidebar {
  min-width: 264px;
  max-width: min(300px, 44vw);
}
/* 风险评估：四个子模块选项卡一行排开把面板撑到 420px。
   收窄到 340px，选项卡改 2×2，用一行高度换 80px 宽度。 */
body.rhs-v2 .alert-sidebar {
  min-width: 296px;
  max-width: min(340px, 44vw);
}
body.rhs-v2 .alert-sidebar .flood-submodule-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  border-bottom: 0;
  margin-bottom: 12px;
}
body.rhs-v2 .disaster-sidebar.active,
body.rhs-v2 .simulate-sidebar.active,
body.rhs-v2 .alert-sidebar.active,
body.rhs-v2 .decision-sidebar.active { right: var(--rhs-gap); }
body.rhs-v2 .disaster-sidebar::-webkit-scrollbar,
body.rhs-v2 .simulate-sidebar::-webkit-scrollbar,
body.rhs-v2 .alert-sidebar::-webkit-scrollbar,
body.rhs-v2 .decision-sidebar::-webkit-scrollbar { width: 5px; display: block; }
body.rhs-v2 .disaster-sidebar::-webkit-scrollbar-thumb,
body.rhs-v2 .simulate-sidebar::-webkit-scrollbar-thumb,
body.rhs-v2 .alert-sidebar::-webkit-scrollbar-thumb,
body.rhs-v2 .decision-sidebar::-webkit-scrollbar-thumb {
  background: rgba(125, 211, 252, .28); border-radius: 3px;
}

/* 抽屉头部：一行标题 + 收起按钮，不再占 24px 大留白 */
body.rhs-v2 .disaster-sidebar-header,
body.rhs-v2 .simulate-sidebar-header,
body.rhs-v2 .alert-sidebar-header,
body.rhs-v2 .decision-sidebar-header {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  flex: 0 0 auto; margin: 0 2px 10px; padding: 0 0 9px;
  border-bottom: 1px solid var(--rhs-line-2);
}
body.rhs-v2 .disaster-sidebar-title,
body.rhs-v2 .simulate-sidebar-title,
body.rhs-v2 .alert-sidebar-title,
body.rhs-v2 .decision-sidebar-title {
  margin: 0; font-size: 13px; font-weight: 500; letter-spacing: .2px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
/* 标题用饱和的模块主色（2026-11-27 18:19 用户反馈提亮版太浅） */
body.rhs-v2 .disaster-sidebar-title,
body.rhs-v2 .simulate-sidebar-title,
body.rhs-v2 .alert-sidebar-title,
body.rhs-v2 .decision-sidebar-title { color: var(--mod); }
/* 右侧栏标题前的类别图标：颜色由 JS 按类别内联设置 */
body.rhs-v2 .rhs-title-icon { margin-right: 8px; font-size: 13px; vertical-align: -1px; }
body.rhs-v2 .disaster-sidebar-close,
body.rhs-v2 .simulate-sidebar-close,
body.rhs-v2 .alert-sidebar-close,
body.rhs-v2 .decision-sidebar-close {
  flex: 0 0 auto; width: 26px; height: 26px; padding: 0;
  display: flex; align-items: center; justify-content: center;
  border: 1px solid transparent; border-radius: 6px;
  background: transparent;
  font-size: 18px; line-height: 1;
  transition: border-color .15s, color .15s, background .15s;
}
/* 收起（最小化）按钮取模块主题色 */
body.rhs-v2 .disaster-sidebar-close,
body.rhs-v2 .simulate-sidebar-close,
body.rhs-v2 .alert-sidebar-close,
body.rhs-v2 .decision-sidebar-close { color: var(--mod-ink); }
body.rhs-v2 .disaster-sidebar-close:hover,
body.rhs-v2 .simulate-sidebar-close:hover,
body.rhs-v2 .alert-sidebar-close:hover,
body.rhs-v2 .decision-sidebar-close:hover {
  border-color: var(--mod); color: #fff; background: var(--mod-soft);
}

/* 内容分区：示范页 .card 的口径 */
body.rhs-v2 .alert-category-sidebar,
body.rhs-v2 .simulate-category-sidebar,
body.rhs-v2 .disaster-category-sidebar,
body.rhs-v2 .decision-category-sidebar {
  margin: 0 0 8px; padding: 0;
  background: transparent; border: 0; border-radius: 0;
  box-shadow: none; overflow: visible; transform: none;
}
body.rhs-v2 .alert-category-sidebar-content,
body.rhs-v2 .simulate-category-sidebar-content,
body.rhs-v2 .disaster-category-sidebar-content,
body.rhs-v2 .decision-content-sidebar,
body.rhs-v2 .expert-sidebar-content {
  background: var(--rhs-card);
  border: 1px solid var(--rhs-line);
  border-radius: 10px;
  padding: 10px 11px;
  margin-bottom: 8px;
}
body.rhs-v2 .alert-category-sidebar-header,
body.rhs-v2 .simulate-category-sidebar-header {
  padding: 0 0 7px; margin-bottom: 8px;
  background: transparent; color: var(--rhs-ice);
  border-bottom: 1px solid var(--rhs-line);
  font-size: 11px; font-weight: 500;
}

/* 灾害数据库 / 风险评估的图层行 */
body.rhs-v2 .alert-layer-item-sidebar,
body.rhs-v2 .disaster-layer-item-sidebar {
  display: flex; align-items: center; gap: 8px;
  margin: 0 0 5px; padding: 6px 8px;
  background: rgba(27, 40, 64, .5);
  border: 1px solid transparent; border-radius: 7px;
  transition: border-color .15s, background .15s;
}
body.rhs-v2 .alert-layer-item-sidebar:hover,
body.rhs-v2 .disaster-layer-item-sidebar:hover { border-color: var(--rhs-line-2); }
/* 选中行高亮取模块色 */
body.rhs-v2 .disaster-layer-item-sidebar:has(input:checked),
body.rhs-v2 .alert-layer-item-sidebar:has(input:checked) {
  border-color: var(--mod-line); background: var(--mod-soft);
}
body.rhs-v2 .alert-layer-checkbox-sidebar,
body.rhs-v2 .disaster-layer-checkbox-sidebar {
  width: 14px; height: 14px; margin: 0; cursor: pointer;
  accent-color: var(--mod);
}
body.rhs-v2 .alert-layer-label-sidebar,
body.rhs-v2 .disaster-layer-label-sidebar {
  flex: 1; min-width: 0; padding: 0; margin: 0;
  border: 0; background: transparent; box-shadow: none;
  font-size: 12px; font-weight: 400; line-height: 1.4; color: var(--rhs-ink);
}
body.rhs-v2 .disaster-layer-label-sidebar:hover,
body.rhs-v2 .alert-layer-label-sidebar:hover {
  background: transparent; border: 0; box-shadow: none; color: var(--mod-ink);
}
/* 勾选后文字用模块主题色 */
body.rhs-v2 .disaster-layer-checkbox-sidebar:checked + .disaster-layer-label-sidebar,
body.rhs-v2 .alert-layer-checkbox-sidebar:checked + .alert-layer-label-sidebar { color: var(--mod-ink); }
/* 收窄面板后图层名允许多行，最多两行，超出省略（用高度换宽度） */
body.rhs-v2 .disaster-layer-name {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  white-space: normal;
  word-break: break-word;
}
body.rhs-v2 .alert-layer-count-sidebar,
body.rhs-v2 .disaster-layer-count-sidebar {
  flex: 0 0 auto; font-size: 10px; font-weight: 400; color: var(--rhs-ink-2);
  padding: 1px 5px; border-radius: 8px;
}
body.rhs-v2 .disaster-layer-check-mark {
  width: 14px; height: 14px; font-size: 9px; background: var(--mod);
}

/* 灾害数据库：分类图层列表下方的数据来源说明 */
.disaster-source-note {
  margin: 8px 0 0;
  padding: 9px 11px;
  background: rgba(27, 40, 64, .5);
  border: 1px solid var(--rhs-line, rgba(125, 211, 252, .18));
  border-radius: 8px;
}
.disaster-source-title {
  display: flex; align-items: center; gap: 6px;
  margin: 0 0 5px;
  font-size: 10.5px; font-weight: 500; color: var(--mod-ink, #fef3c7);
}
.disaster-source-title i { font-size: 10px; opacity: .85; }
.disaster-source-note p {
  margin: 0;
  font-size: 11px; line-height: 1.6; color: var(--rhs-ink-2, #b7c6dc);
  overflow-wrap: anywhere;
}

/* 表单 / 标签 / 按钮：紧凑单轴，不再用大号白底控件 */
body.rhs-v2 .alert-category-sidebar-content > label,
body.rhs-v2 .simulate-category-sidebar-content > label,
body.rhs-v2 .alert-category-sidebar-content > .alert-section label {
  display: block; margin: 0 0 5px;
  font-size: 11px; font-weight: 400; color: var(--rhs-ink);
}
body.rhs-v2 .alert-category-sidebar-content > select,
body.rhs-v2 .alert-category-sidebar-content > input[type="date"],
body.rhs-v2 .alert-category-sidebar-content > input[type="text"],
body.rhs-v2 .simulate-category-sidebar-content > select,
body.rhs-v2 .simulate-category-sidebar-content > input[type="date"],
body.rhs-v2 .simulate-category-sidebar-content > input[type="text"] {
  width: 100%; box-sizing: border-box;
  padding: 6px 8px; margin: 0 0 9px;
  background: rgba(10, 20, 36, .7); border: 1px solid var(--rhs-line-2);
  border-radius: 6px; color: var(--rhs-ink); font-size: 11px; color-scheme: dark;
}
body.rhs-v2 .flood-submodule-tabs .tab-btn,
body.rhs-v2 .weight-method-opt,
body.rhs-v2 .decision-chip {
  padding: 5px 8px; border-radius: 6px;
  border: 1px solid var(--rhs-line-2); background: rgba(27, 40, 64, .6);
  color: var(--rhs-ink); font-size: 11px; font-weight: 400;
  transition: border-color .15s, color .15s, background .15s;
}
body.rhs-v2 .flood-submodule-tabs .tab-btn:hover,
body.rhs-v2 .weight-method-opt:hover,
body.rhs-v2 .decision-chip:hover { border-color: var(--mod); color: var(--rhs-ink); }
/* 选中态的模块色统一由下方「选中 tab / 主按钮」段接管，此处不再写死蓝色 */
body.rhs-v2 .alert-section { margin-bottom: 10px; }
body.rhs-v2 .alert-section-title {
  margin: 0 0 8px; padding-bottom: 6px;
  border-bottom: 1px solid var(--rhs-line);
  font-size: 11px; font-weight: 500; color: var(--rhs-ink);
}
body.rhs-v2 .alert-sidebar .btn,
body.rhs-v2 .simulate-sidebar .btn,
body.rhs-v2 .decision-sidebar .btn {
  padding: 7px 10px; border-radius: 6px; font-size: 11px;
}
body.rhs-v2 #simulate-results thead,
body.rhs-v2 #flood-results thead { background: rgba(27, 40, 64, .9) !important; }
body.rhs-v2 #no-result-tip,
body.rhs-v2 #no-flood-result-tip { color: var(--rhs-ink-2) !important; }
body.rhs-v2 .decision-content-note {
  padding: 8px 9px; font-size: 11px; line-height: 1.55;
}
body.rhs-v2 .decision-content-sidebar { gap: 8px; }

/* ---------- 边缘竖标签：替换原滑出抽屉的「无入口」状态 ---------- */
body.rhs-v2 .rhs-tab {
  /* fixed + 50% + translateY(-50%)：不受任何父容器影响，永远是视口右缘正中
     （原先按右侧栏垂直中点算，比屏幕中心偏下约 30px，2026-11-27 21:19 修正） */
  position: fixed; z-index: 31;
  top: 50%; right: 0; transform: translateY(-50%);
  /* 高度随文字长度自适应（「灾害过程模拟」6 字比 4 字长一截），min-height 保底 */
  width: 34px; height: auto; min-height: 116px; padding: 14px 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 8px;
  border: 0; border-radius: 10px 0 0 10px;
  background: linear-gradient(180deg, rgba(25, 39, 62, .97) 0%, rgba(15, 25, 43, .97) 100%);
  color: var(--mod);
  /* 左侧一条模块色内高光 + 顶部一道白色微光，代替外框线 */
  box-shadow:
    inset 1px 0 0 var(--mod-line),
    inset 0 1px 0 rgba(255, 255, 255, .06),
    0 6px 20px rgba(0, 0, 0, .4);
  cursor: pointer; outline: none;
  transition: transform .22s ease, opacity .22s ease, box-shadow .2s ease, color .15s ease;
}
/* 模块图标：数据库 / 过程模拟 / 风险评估 / 决策支持 */
body.rhs-v2 .rhs-tab::before {
  font: normal normal normal 13px/1 FontAwesome;
  color: var(--mod);
  transition: color .15s ease, text-shadow .2s ease;
}
body.rhs-v2[data-module="disaster"] .rhs-tab::before { content: "\f1c0"; }
/* 与标题图标统一为 fa-play-circle（\f144），原 \f0c3 是 fa-flask，两边不一致 */
body.rhs-v2[data-module="simulate"] .rhs-tab::before { content: "\f144"; }
body.rhs-v2[data-module="alert"] .rhs-tab::before { content: "\f071"; }
body.rhs-v2[data-module="decision"] .rhs-tab::before { content: "\f0eb"; }
body.rhs-v2 .rhs-tab span {
  writing-mode: vertical-rl; font-size: 11px; letter-spacing: 3px;
  transition: color .15s ease;
}
/* 悬停：整块向左滑出 3px，暗示"可以拉开" */
body.rhs-v2 .rhs-tab:hover {
  transform: translate(-3px, -50%);
  color: #fff;
  box-shadow:
    inset 1px 0 0 var(--mod),
    inset 0 1px 0 rgba(255, 255, 255, .08),
    0 8px 24px rgba(0, 0, 0, .48);
}
body.rhs-v2 .rhs-tab:hover::before {
  color: #fff;
  text-shadow: 0 0 10px var(--mod-line);
}
/* 面板展开时把手隐藏：竖条只属于「收起态」，滑出屏幕右侧（2026-11-27 21:09 用户要求）
   收起后靠 right:0 + top:50% 回到屏幕右缘中心。 */
body.rhs-v2 .disaster-sidebar.active ~ .rhs-tab,
body.rhs-v2 .simulate-sidebar.active ~ .rhs-tab,
body.rhs-v2 .alert-sidebar.active ~ .rhs-tab,
body.rhs-v2 .decision-sidebar.active ~ .rhs-tab {
  opacity: 0;
  transform: translate(100%, -50%);
  pointer-events: none;
}

/* ---------- 图层管理浮层（main.js 的 .sidepanel / .sidepanel-toggle） ---------- */
body.rhs-v2 .sidepanel {
  top: calc(var(--nav-height) + var(--rhs-gap));
  left: var(--rhs-gap);
  width: var(--rhs-w);
  max-height: calc(100vh - var(--nav-height) - 22px);
  padding: 10px;
  background: var(--rhs-surface);
  border: 1px solid var(--rhs-line-2);
  border-radius: 10px;
  box-shadow: 0 8px 30px rgba(0, 0, 0, .38);
  backdrop-filter: blur(10px);
  scrollbar-width: thin;
  scrollbar-color: rgba(125, 211, 252, .32) transparent;
  /* 收起状态与展开按钮沿用原规则：left:-340px + 44px 圆形图标钮，不改成竖标签 */
}
body.rhs-v2 .sidepanel-head {
  margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid var(--rhs-line-2);
}
body.rhs-v2 .sidepanel-head-title {
  font-size: 13px; font-weight: 500; color: var(--mod);
}
/* 左侧面板跟随当前页面的模块主题色（图标 / × / 展开钮同一色，均用饱和主色） */
body.rhs-v2 .sidepanel-head-title i { color: var(--mod); }
