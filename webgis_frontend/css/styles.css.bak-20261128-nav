  opacity: 0;
  pointer-events: none; /* 非模态：不拦截地图与左侧栏操作 */
  transition: opacity 0.25s ease;
}
  .disaster-sidebar-mask.active,
.simulate-sidebar-mask.active,
.alert-sidebar-mask.active {
