  gap: 4px;
}
.expert-source {
  font-size: 10px;
  color: #8ba0bd;
  word-break: break-all;
  line-height: 1.5;
}

/* ============================================================
   决策支持内容（防灾实例 / 工程措施 / 非工程措施）
   ============================================================ */
.decision-content-sidebar {
  padding: 14px 16px 16px;
